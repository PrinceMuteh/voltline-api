NODE_ENV=development
PORT=4000

# Matches docker-compose.yml
DATABASE_URL=postgresql://voltline:voltline@localhost:5435/voltline?schema=public
REDIS_URL=redis://localhost:6380

# Origin of voltline-web, allowed by CORS
WEB_ORIGIN=http://localhost:3000

# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# Set to true behind HTTPS so auth cookies are Secure
COOKIE_SECURE=false

# Shown to operators in Add a charger; chargers append /{chargePointId}.
# Production: wss://ocpp.voltline.example/ocpp (TLS terminated in front of the API)
OCPP_PUBLIC_URL=ws://localhost:4000/ocpp

# The driver app is white-labelled per operator: the workspace it serves
DRIVER_APP_WORKSPACE=Voltline Demo
